{
  "name": "fcp-sfd-bank-details",
  "version": "0.0.0",
  "description": "fcp-sfd-bank-details",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "check:synthetic-ids": "sfd-id-check --staged",
    "dev": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development JWT_AUTH_BYPASS=true npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development JWT_AUTH_BYPASS=true npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "security-audit": "npm audit --audit-level=critical",
    "server:debug": "node --watch --inspect-brk=0.0.0.0 --env-file-if-exists=.env ./src",
    "server:watch": "node --watch --inspect=0.0.0.0 --env-file-if-exists=.env ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node . --env-file-if-exists=.env",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.3",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.2",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.12",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "joi": "18.3.1",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "fcp-sfd-core": "github:DEFRA/fcp-sfd-core#95f58ade56b2d0dd0f15bdcba6a5f37a54bcc939",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "vitest": "4.1.12",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "hapi-pulse": {
      "joi": "18.3.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
